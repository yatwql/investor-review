// 计价参考数据（llm_pricing_ref.json）
// 参考数据不是用户开关：不进 TUI/Web 配置面板；改价直接编辑本文件。
// 合并口径：constants.py 的 MODEL_PRICING 为基础价，本文件 models 逐模型覆盖
// 出现的字段，未出现的字段继承内置值。文件缺失时仅用内置价。
{
  "version": 1,   // 结构版本；不符即拒绝加载并提示重新生成
  "currency": "CNY",   // 货币标识（影响费用符号）
  "timezone": "Asia/Shanghai",   // 峰谷判定时区（IANA 名称）
  "peak_periods": ["09:00-12:00", "14:00-18:00"],   // 高峰时段（HH:MM-HH:MM，闭区间）
  "idle_periods": [],   // 闲时时段（空 = 高峰之外均闲时）
  "weekend_always_idle": true,   // 周末全天按闲时价
  "holiday_always_idle": true,   // 法定节假日全天按闲时价
  "models": {
    // 逐模型覆盖示例（单位：元 / 百万 token；未写字段继承内置价）：
    // "deepseek-flash": {"input_price": 1.0, "output_price": 4.0,
    //                     "peak": {"input_price": 2.0, "output_price": 8.0}}
  }
}
