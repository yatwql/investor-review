{
  // LLM Provider 多链配置（链序按 priority 升序，数值小者靠前，与数组项顺序无关）
  // 线路：DeepSeek（按量付费端点）
  // 线路：Kimi K3（OpenCode Go 订阅中转，Anthropic 兼容端点；api_key 在 llm_key.json 的
  //     kimi-opencode-go 块，未填时该条目轮空失败不影响主源）

  "strategy": "priority",
  "preferred_providers": {},
  "providers": [
    {
      "name": "deepseek-main",
      "provider": "claude",
      "credentials_ref": "deepseek-main",
      "priority": 10,
      "timeout": 120
    },
    {
      "name": "opencode-go",
      "provider": "claude",
      "credentials_ref": "opencode-go",
      "priority": 20,
      "timeout": 120,
      "pacing": {
        "min_interval": 5,
        "max_concurrency": 1
      }
    }
  ]
}
