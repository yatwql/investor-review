{
  // LLM Provider 多链配置：按 priority 升序逐条尝试，直到第一条成功返回
  // 链序真值看 providers[].priority（数值小者靠前），与数组项摆放顺序无关；
  // 调顺序用 [G]→[M] 面板 / Web 配置面 / --llm-provider-order，不必手改数组
  //
  // 两条线路都是 Anthropic 兼容端点，密钥与模型按 credentials_ref 写在 llm_key.json：
  //   deepseek-main  → llm_key.json 同名块（api_key / model / endpoint）
  //   opencode-go    → llm_key.json 同名块（api_key / model / endpoint）
  //
  // pacing 是端点级节流（只约束本条目的端点），不写该段 = 无额外约束：
  //   min_interval=两次请求最小间隔秒；jitter=间隔随机抖动比例(0~1)；max_concurrency=在途上限

  "strategy": "priority",
  "preferred_providers": {},
  "providers": [
    // DeepSeek：Anthropic 兼容的按量付费端点，不额外限速
    {
      "name": "deepseek-main",
      "provider": "claude",
      "credentials_ref": "deepseek-main",
      "priority": 10,
      "timeout": 120
    },
    // OpenCode Go：订阅制编码中转（Anthropic 兼容）；pacing 令请求串行低频（间隔 ≥5s、在途 ≤1），去掉该段即无额外约束
    {
      "name": "opencode-go",
      "provider": "claude",
      "credentials_ref": "opencode-go",
      "priority": 20,
      "timeout": 120,
      "pacing": {"min_interval": 5, "max_concurrency": 1}
    }
  ]
}
