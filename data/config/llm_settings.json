{
  "schema_version": 2,   // 结构版本；缺失或不为 2 时拒绝加载，需删除后重新生成

  // ── 缺省：所有模块继承；模块内只写差异 ──
  "defaults": {
    "model": null,  // 模型名；null = 用线路默认模型
    "temperature": 0.3,  // 采样温度（越低越确定）
    "max_tokens": 3072,  // 单次调用最大输出 token
    "timeout": 60,  // 单次调用超时（秒）
    "cache": true,  // 是否启用磁盘缓存
    "output_brief": false,  // 是否要求精简输出
    "system_prompt": null,  // 自定义系统提示词；null = 用内置
    "thinking": {
      "enabled": false,  // 是否启用思考模式
      "budget": null,  // 思考预算 token；null = 用端点默认
      "effort": null  // 推理强度 low/medium/high；null = 不指定
    }
  },

  // ── 模块：一个业务对象一段（启停与参数同段；未写项继承 defaults）──
  "modules": {
    // 全球政经局势（global_macro）
    "global_macro": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "thinking": {
        "enabled": false,  // 是否启用（模块启停 / 思考模式）
        "budget": 6000,
        "effort": "low"
      },
      "system_prompt": null,  // 自定义系统提示词；null = 用内置
      "model": null,  // 模型名；null = 用线路默认模型
      "temperature": 0.3,  // 采样温度（越低越确定）
      "max_tokens": 3072,  // 单次调用最大输出 token
      "timeout": 60,  // 单次调用超时（秒）
      "cache": true,  // 是否启用磁盘缓存
      "output_brief": false  // 是否要求精简输出
    },
    // 智囊团深度复盘（expert_review）
    "expert_review": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "max_tokens": 36000,  // 单次调用最大输出 token
      "timeout": 120,  // 单次调用超时（秒）
      "thinking": {
        "enabled": true,  // 是否启用（模块启停 / 思考模式）
        "budget": 24000,
        "effort": "medium"
      },
      "debate": {},
      "system_prompt": null,  // 自定义系统提示词；null = 用内置
      "model": null,  // 模型名；null = 用线路默认模型
      "temperature": 0.3,  // 采样温度（越低越确定）
      "cache": true,  // 是否启用磁盘缓存
      "output_brief": false  // 是否要求精简输出
    },
    // 财经新闻热点与持仓关联分析（news_correlation）
    "news_correlation": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "temperature": 0.1,  // 采样温度（越低越确定）
      "max_tokens": 3000,  // 单次调用最大输出 token
      "output_brief": null,  // 是否要求精简输出
      "thinking": {
        "enabled": false,  // 是否启用（模块启停 / 思考模式）
        "budget": 6000,
        "effort": "low"
      },
      "system_prompt": null,  // 自定义系统提示词；null = 用内置
      "model": null,  // 模型名；null = 用线路默认模型
      "timeout": 60,  // 单次调用超时（秒）
      "cache": true  // 是否启用磁盘缓存
    },
    // 持仓体检报告（health_check）
    "health_check": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "temperature": 0.1,  // 采样温度（越低越确定）
      "max_tokens": 24000,  // 单次调用最大输出 token
      "timeout": 120,  // 单次调用超时（秒）
      "thinking": {
        "enabled": true,  // 是否启用（模块启停 / 思考模式）
        "budget": 18000,
        "effort": "low"
      },
      "system_prompt": null,  // 自定义系统提示词；null = 用内置
      "model": null,  // 模型名；null = 用线路默认模型
      "cache": true,  // 是否启用磁盘缓存
      "output_brief": false  // 是否要求精简输出
    },
    // 穿透深度分析（penetration_deep）
    "penetration_deep": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "temperature": 0.1,  // 采样温度（越低越确定）
      "max_tokens": 12288,  // 单次调用最大输出 token
      "timeout": 90,  // 单次调用超时（秒）
      "thinking": {
        "enabled": false,  // 是否启用（模块启停 / 思考模式）
        "budget": 12000,
        "effort": "low"
      },
      "system_prompt": null,  // 自定义系统提示词；null = 用内置
      "model": null,  // 模型名；null = 用线路默认模型
      "cache": true,  // 是否启用磁盘缓存
      "output_brief": false  // 是否要求精简输出
    },
    // 生成后自检（self_review）
    "self_review": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "temperature": 0.1,  // 采样温度（越低越确定）
      "max_tokens": 2048,  // 单次调用最大输出 token
      "timeout": 90,  // 单次调用超时（秒）
      "thinking": {
        "enabled": false,  // 是否启用（模块启停 / 思考模式）
        "budget": 6000,
        "effort": "low"
      }
    },
    // 持仓变动复盘归因（holding_change）
    "holding_change": {
      "enabled": false,  // 是否启用（模块启停 / 思考模式）
      "temperature": 0.2,  // 采样温度（越低越确定）
      "max_tokens": 2048,  // 单次调用最大输出 token
      "timeout": 90,  // 单次调用超时（秒）
      "thinking": {
        "enabled": false,  // 是否启用（模块启停 / 思考模式）
        "budget": 6000,
        "effort": "low"
      }
    }
  },

  // ── 运行约束：并发 / 重试 / 预算（面板「LLM 运行」域）──
  "runtime": {
    "max_concurrency": 3,  // 普通模块并发上限
    "thinking_concurrency": 2,  // 思考模块并发上限
    "max_retries": 2,  // 单模块重试次数
    "full_fail_retry_delay_sec": 30,  // 全链路失败后整链重试等待（秒，0=不等）
    "time_budget_sec": 0,  // 报告总时间预算（秒，0=不启用）
    "daily_cost_limit": 0,  // LLM 日费用上限（0=不启用）
    "debate_limits": {
      "max_tokens_per_report": 72000,  // 辩论单报告 token 预算
      "call_timeout_override_sec": 90  // 辩论单次调用超时覆盖（秒，0=沿用模块）
    }
  },

  // ── 高级选项：事实校验 / 新闻条数 / 计价覆盖 ──
  "advanced": {
    "fact_check": {
      "tolerance": 1.0,  // 事实校验容差
      "tolerance_overrides": {
        "expert_review": 2.0,
        "health_check": 1.0,
        "global_macro": 1.0,
        "penetration_deep": 1.0
      }
    },
    "news_correlation": {
      "top_n": 30  // 新闻关联条数上限
    }
  },

  // ── 未识别的顶层键（原样保留，供扩展字段使用）──
  "llm_max_concurrency": 3,
  "llm_max_thinking_concurrency": 2
}
