// 日志运行配置（logger.json）
// 格式：文件 / 控制台 / 查看器三段；环境变量 INVEST_LOG_FILE_LEVEL /
// INVEST_LOG_CONSOLE_LEVEL 可临时覆盖级别（优先级高于本文件）。
{
  "version": 1,

  // ── 写盘 ──
  "file": {
    "path": "logs/app.log",   // 相对项目根或绝对路径
    "level": "INFO",   // 写盘级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
    "max_bytes": 10485760,   // 单文件上限（字节）
    "backup_count": 5   // 备份份数（0 = 不轮转）
  },

  // ── 控制台 ──
  "console": {
    "level": "INFO",   // 控制台级别
    "color": true   // 允许颜色（不支持/NO_COLOR 时自动降级）
  },

  // ── 日志查看器（TUI [D]→[V] / Web「运行日志」）──
  "viewer": {
    "default_level": "INFO",   // 默认筛选级别；ALL = 不过滤
    "tail_lines": 500   // 首屏读取行数上限
  }
}
